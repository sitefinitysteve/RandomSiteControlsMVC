<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>RandomSiteControlsMVC</id>
    <version>$version$</version>
    <authors>Steve McNiven-Scott</authors>
    <tags>Sitefinity Widgets Controls GoogleMaps</tags>
    <description>
      A random bunch of MVC Feather controls and extensions to improve your sitefinity experience
      - Tabstrip, Kendo or Bootstrap
      - Markdown Editor
      - Document Tree
      - Print to PDF
      - Google maps widget
      - Page Title widget
      - Versioned Css\Js MVC Link helpers
      - HTML Literal Editor (No designer or markup mangling, uses inbrowser VSCode editor)
      - Widget finder
      - HttpModule to remove IIS sensitive header info
    </description>
	  <summary>
        A random bunch of MVC Feather controls and extensions to improve your sitefinity experience
    </summary>
	  <projectUrl>https://github.com/sitefinitysteve/RandomSiteControlsMVC</projectUrl>
    <dependencies>
		<group targetFramework=".NETFramework4.8">
			<dependency id="Markdig" version="0.42.0" />
		</group>
    </dependencies>
  </metadata>
  <files>
    <file src="Build\ScanControllerContainerAssemblies.ps1" target="lib" />
  </files>
</package>